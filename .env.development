NODE_ENV=development
PORT=4000

# Mongo Docker (docker-compose.infra.yml). directConnection=true bắt buộc:
# replica set advertise host "mongo:27017", BE từ host phải bypass discovery
# để route mọi op qua localhost.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=ordergo

# Random secrets — đổi ở production
JWT_ACCESS_SECRET=dev_access_secret_change_me_to_32_plus_random_chars_xx
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_to_32_plus_random_chars_yy
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGINS=http://localhost:3000
